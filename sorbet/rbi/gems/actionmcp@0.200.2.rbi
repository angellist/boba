  def number(name, required: T.unsafe(nil), description: T.unsafe(nil), minimum: T.unsafe(nil), maximum: T.unsafe(nil), default: T.unsafe(nil)); end

  # Define an object property
  # @param name [Symbol, nil] Object property name. If nil, returns schema directly (for array items)
  # @param required [Boolean] Whether the object is required
  # @param description [String] Property description
  # @param additional_properties [Boolean, Hash] Whether to allow additional properties
  # @param block [Proc] Block defining object properties
  #
  # pkg:gem/actionmcp#lib/action_mcp/output_schema_builder.rb:136
  def object(name = T.unsafe(nil), required: T.unsafe(nil), description: T.unsafe(nil), additional_properties: T.unsafe(nil), &block); end

  # pkg:gem/actionmcp#lib/action_mcp/output_schema_builder.rb:12
  def properties; end

  # Define a property with specified type
  # @param name [Symbol] Property name
  # @param type [String] JSON Schema type
  # @param required [Boolean] Whether the property is required
  # @param description [String] Property description
  # @param options [Hash] Additional JSON Schema options
  #
  # pkg:gem/actionmcp#lib/action_mcp/output_schema_builder.rb:25
  def property(name, type: T.unsafe(nil), required: T.unsafe(nil), description: T.unsafe(nil), **options); end

  # pkg:gem/actionmcp#lib/action_mcp/output_schema_builder.rb:12
  def required; end

  # Define a string property
  #
  # pkg:gem/actionmcp#lib/action_mcp/output_schema_builder.rb:37
  def string(name = T.unsafe(nil), required: T.unsafe(nil), description: T.unsafe(nil), format: T.unsafe(nil), enum: T.unsafe(nil), default: T.unsafe(nil), min_length: T.unsafe(nil), max_length: T.unsafe(nil)); end

  # Generate the final JSON Schema
  #
  # pkg:gem/actionmcp#lib/action_mcp/output_schema_builder.rb:175
  def to_json_schema; end
end

