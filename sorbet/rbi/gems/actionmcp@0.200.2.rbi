  # Enable logging
  # @return [Boolean] true (new value)
  #
  # pkg:gem/actionmcp#lib/action_mcp/logging/state.rb:23
  def enable!; end

  # Set enabled state
  # @param value [Boolean] true to enable, false to disable
  # @return [Boolean] the new value
