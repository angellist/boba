# pkg:gem/actionmcp#lib/action_mcp/engine.rb:68
module ActionMCP::Middleware; end

# Rack middleware that validates the Origin header on MCP requests to
# prevent DNS rebinding attacks per the MCP Streamable HTTP security
# section. Non-browser clients (Claude Desktop, curl) never send Origin
# and are always allowed. Present Origins must match the explicitly trusted
# hosts in `ActionMCP.configuration.allowed_origins`.
#
# Runs as middleware — same layer as `ActionDispatch::HostAuthorization` —
# so invalid requests are rejected before they reach routing.
#
# pkg:gem/actionmcp#lib/action_mcp/middleware/origin_validation.rb:15
class ActionMCP::Middleware::OriginValidation
  # @param app [#call]
  # @param paths [Array<String, Regexp, Proc>, nil] paths to guard.
  #   Nil or empty means every request is guarded.
  #
  # pkg:gem/actionmcp#lib/action_mcp/middleware/origin_validation.rb:21
  def initialize(app, paths = T.unsafe(nil)); end

  # pkg:gem/actionmcp#lib/action_mcp/middleware/origin_validation.rb:26
  def call(env); end

  private

  # pkg:gem/actionmcp#lib/action_mcp/middleware/origin_validation.rb:79
  def forbidden_response; end

  # pkg:gem/actionmcp#lib/action_mcp/middleware/origin_validation.rb:39
  def guard_path?(path); end

  # pkg:gem/actionmcp#lib/action_mcp/middleware/origin_validation.rb:67
  def match?(pattern, host); end

  # pkg:gem/actionmcp#lib/action_mcp/middleware/origin_validation.rb:52
  def origin_allowed?(origin, _request); end

  # pkg:gem/actionmcp#lib/action_mcp/middleware/origin_validation.rb:75
  def strip_brackets(host); end
end

# pkg:gem/actionmcp#lib/action_mcp/middleware/origin_validation.rb:16
ActionMCP::Middleware::OriginValidation::INVALID_REQUEST_CODE = T.let(T.unsafe(nil), Integer)

# Engine-owned MIME type registry. Keeps protocol-level MIME values out of
