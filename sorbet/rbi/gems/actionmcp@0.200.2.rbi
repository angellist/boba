# pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:4
class ActionMCP::LogSubscriber < ::ActiveSupport::LogSubscriber
  # Enhance process_action to include our custom metrics
  #
  # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:179
  def process_action(event); end

  # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:29
  def prompt_call(event); end

  # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:24
  def tool_call(event); end

  class << self
    # Add a custom metric to be included in logs
    #
    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:35
    def add_metric(name, value); end

    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:7
    def custom_metrics; end

    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:7
    def custom_metrics=(_arg0); end

    # Define a group of related metrics
    # @param group_name [Symbol] The name of the metric group
    # @param metrics [Array<Symbol>] The metrics that belong to this group
    #
    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:173
    def define_metric_group(group_name, metrics); end

    # Format metrics for display in logs
    #
    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:93
    def format_metrics; end

    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:7
    def formatters; end

    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:7
    def formatters=(_arg0); end

    # Measure execution time of a block and add as metric
    #
    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:41
    def measure_metric(name); end

    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:7
    def metric_groups; end

    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:7
    def metric_groups=(_arg0); end

    # Register a custom formatter for a specific metric
    # @param metric_name [Symbol] The name of the metric
    # @param block [Proc] The formatter block that takes the value and returns a string
    #
    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:165
    def register_formatter(metric_name, &block); end

    # Reset all custom metrics
    #
    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:51
    def reset_metrics; end

    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:10
    def reset_runtime; end

    # Subscribe to a Rails event to capture metrics
    # @param pattern [String] Event name pattern (e.g., "sql.active_record")
    # @param metric_name [Symbol] Name to use for the metric
    # @param options [Hash] Options for capturing the metric
    #
    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:59
    def subscribe_event(pattern, metric_name, options = T.unsafe(nil)); end

    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:7
    def subscribed_events; end

    # pkg:gem/actionmcp#lib/action_mcp/log_subscriber.rb:7
    def subscribed_events=(_arg0); end
  end
end

# Global MCP logging interface
#
# pkg:gem/actionmcp#lib/action_mcp/logging.rb:9
module ActionMCP::Logging
  class << self
    # Disable MCP logging
    # @return [Boolean] false
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging.rb:40
    def disable!; end

    # Enable MCP logging
    # @return [Boolean] true
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging.rb:33
    def enable!; end

    # Check if logging is enabled
    # @return [Boolean] true if enabled
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging.rb:27
    def enabled?; end

    # Initialize logging state based on configuration
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging.rb:115
    def initialize_from_config!; end

    # Get the current minimum log level
    # @return [Symbol] current level
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging.rb:46
    def level; end

    # Set the minimum log level
    # @param new_level [String, Symbol, Integer] the new level
    # @return [Symbol] the new level as symbol
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging.rb:53
    def level=(new_level); end

    # Return the minimum log level negotiated for a session, falling back to
    # the configured server default until the client sends logging/setLevel.
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging.rb:61
    def level_for(session); end

    # Create a logger for the given session
    # @param name [String, nil] Optional logger name
    # @param session [ActionMCP::Session] The MCP session
    # @return [ActionMCP::Logging::Logger, ActionMCP::Logging::NullLogger] logger instance
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging.rb:94
    def logger(session:, name: T.unsafe(nil)); end

    # Convenience method to get a logger for the current session context
    # @param name [String, nil] Optional logger name
    # @param execution_context [Hash] Context containing session
    # @return [ActionMCP::Logging::Logger, ActionMCP::Logging::NullLogger] logger instance
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging.rb:106
    def logger_for_context(execution_context:, name: T.unsafe(nil)); end

    # Reset the global state (for testing)
    # @return [void]
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging.rb:21
    def reset!; end

    # pkg:gem/actionmcp#lib/action_mcp/logging.rb:57
    def set_level(new_level); end

    # pkg:gem/actionmcp#lib/action_mcp/logging.rb:67
    def set_level_for(session, new_level); end

    # Get the global logging state
    # @return [ActionMCP::Logging::State] The global state
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging.rb:15
    def state; end

    # pkg:gem/actionmcp#lib/action_mcp/logging.rb:82
    def supported_by?(session); end
  end
end

# RFC 5424 log levels for MCP logging
# @see https://datatracker.ietf.org/doc/html/rfc5424#section-6.2.1
#
# pkg:gem/actionmcp#lib/action_mcp/logging/level.rb:7
class ActionMCP::Logging::Level
  class << self
    # Get all valid level names as symbols
    # @return [Array<Symbol>] Array of level symbols
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging/level.rb:70
    def all_levels; end

    # Coerce a level to its integer value
    # @param level [String, Symbol, Integer] The level to coerce
    # @return [Integer] The integer severity value
    # @raise [ArgumentError] if level is invalid
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging/level.rb:42
    def coerce(level); end

    # Check if level_a is more severe than level_b
    # @param level_a [String, Symbol, Integer] First level
    # @param level_b [String, Symbol, Integer] Second level
    # @return [Boolean] true if level_a >= level_b in severity
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging/level.rb:78
    def more_severe_or_equal?(level_a, level_b); end

    # Convert integer level back to symbol
    # @param level_int [Integer] The integer level
    # @return [Symbol] The symbol name
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging/level.rb:62
    def name_for(level_int); end

    # Check if a level is valid
    # @param level [String, Symbol, Integer] The level to check
    # @return [Boolean] true if valid, false otherwise
    #
    # pkg:gem/actionmcp#lib/action_mcp/logging/level.rb:27
    def valid?(level); end
  end
end

# Log levels in order of severity (ascending)
#
# pkg:gem/actionmcp#lib/action_mcp/logging/level.rb:9
ActionMCP::Logging::Level::LEVELS = T.let(T.unsafe(nil), Hash)

# Reverse mapping for converting integers back to symbols
#
# pkg:gem/actionmcp#lib/action_mcp/logging/level.rb:21
ActionMCP::Logging::Level::LEVEL_NAMES = T.let(T.unsafe(nil), Hash)

