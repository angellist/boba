# pkg:gem/actionmcp#lib/action_mcp/server/resources.rb:5
module ActionMCP::Server::Resources
  # Read and return the contents of a resource
  #
  # @param id [String, Integer] The ID of the request to respond to
  # @param params [Hash] Parameters specifying which resource to read
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/resources.rb:47
  def send_resource_read(id, params); end

  # Subscribe the current session to updates for an available resource.
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/resources.rb:112
  def send_resource_subscribe(id, uri); end

  # Send list of resource templates to the client
  #
  # @param request_id [String, Integer] The ID of the request to respond to
  # @param params [Hash] Optional params including "cursor" for pagination
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/resources.rb:29
  def send_resource_templates_list(request_id, params = T.unsafe(nil)); end

  # Remove a resource update subscription. Unsubscribing is idempotent.
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/resources.rb:123
  def send_resource_unsubscribe(id, uri); end

  # Send list of concrete resources to the client.
  # Aggregates resources from templates that implement self.list.
  #
  # @param request_id [String, Integer] The ID of the request to respond to
  # @param params [Hash] Optional params including "cursor" for pagination
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/resources.rb:11
  def send_resources_list(request_id, params = T.unsafe(nil)); end

  private

  # Collect all concrete resources from templates that implement list.
  # Returns nil if a URI collision error was sent.
  # @return [Array<ActionMCP::Resource>, nil]
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/resources.rb:148
  def collect_resources(request_id); end

  # pkg:gem/actionmcp#lib/action_mcp/server/resources.rb:130
  def find_registered_template_for_uri(uri); end

  # Log all registered resource templates
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/resources.rb:214
  def log_resource_templates; end

  # Normalize a content object to MCP ReadResourceResult content shape.
  #
  # @return [Hash] with keys: uri, mimeType, text or blob, and optional _meta
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/resources.rb:199
  def normalize_read_content(content, _uri); end

  # pkg:gem/actionmcp#lib/action_mcp/server/resources.rb:137
  def resource_not_found_error(uri); end
end

# Module to collect responses when operating in :return mode
#
# pkg:gem/actionmcp#lib/action_mcp/server/response_collector.rb:6
module ActionMCP::Server::ResponseCollector
  # Clear collected responses
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/response_collector.rb:39
  def clear_collected_responses; end

  # pkg:gem/actionmcp#lib/action_mcp/server/response_collector.rb:7
  def collected_responses; end

  # Get all collected responses
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/response_collector.rb:29
  def get_collected_responses; end

  # Get the last response (useful for single request/response scenarios)
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/response_collector.rb:34
  def get_last_response; end

  # pkg:gem/actionmcp#lib/action_mcp/server/response_collector.rb:9
  def initialize_response_collector; end

  # Collect messages for the HTTP response while retaining the session's
  # complete wire history. Server-initiated requests cannot be placed in
  # the empty 202 response required for an incoming notification, so the
  # generated request must not be silently discarded.
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/response_collector.rb:17
  def write_message(message); end
end

