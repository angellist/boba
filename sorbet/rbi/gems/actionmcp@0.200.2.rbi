  # pkg:gem/actionmcp#lib/action_mcp/logging/logger.rb:33
  def info(message = T.unsafe(nil), data: T.unsafe(nil), &block); end

  # Check if info level is enabled
  # @return [Boolean] true if info messages will be logged
