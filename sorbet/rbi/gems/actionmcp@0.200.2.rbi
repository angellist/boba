  # @param max_items [Integer] Maximum number of items
  # @param items [Hash] Items schema (if not using block)
  # @param block [Proc] Block defining item schema
  #
  # pkg:gem/actionmcp#lib/action_mcp/output_schema_builder.rb:91
  def array(name, description: T.unsafe(nil), min_items: T.unsafe(nil), max_items: T.unsafe(nil), items: T.unsafe(nil), &block); end

