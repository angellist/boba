  def emergency(message = T.unsafe(nil), data: T.unsafe(nil), &block); end

  # Check if emergency level is enabled
  # @return [Boolean] true if emergency messages will be logged
  #
  # pkg:gem/actionmcp#lib/action_mcp/logging/logger.rb:137
