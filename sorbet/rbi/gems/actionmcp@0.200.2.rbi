  # pkg:gem/actionmcp#lib/action_mcp/test_helper/progress_notification_assertions.rb:89
  def progress_session_store; end

  private

  # pkg:gem/actionmcp#lib/action_mcp/test_helper/progress_notification_assertions.rb:100
