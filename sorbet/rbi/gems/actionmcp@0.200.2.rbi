module ActionMCP::Server::SessionStore
  # Cleanup expired sessions
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/session_store.rb:38
  def cleanup_expired_sessions(older_than: T.unsafe(nil)); end

  # Create a new session
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/session_store.rb:8
  def create_session(session_id = T.unsafe(nil), attributes = T.unsafe(nil)); end

  # Delete session
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/session_store.rb:23
  def delete_session(session_id); end

  # Find sessions by criteria
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/session_store.rb:33
  def find_sessions(criteria = T.unsafe(nil)); end

  # Load session by ID
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/session_store.rb:13
  def load_session(session_id); end

  # Save/update session
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/session_store.rb:18
  def save_session(session); end

  # Check if session exists
  #
  # pkg:gem/actionmcp#lib/action_mcp/server/session_store.rb:28
  def session_exists?(session_id); end
end

