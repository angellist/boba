    # @return [void]
    #
    # pkg:gem/actionmcp#lib/action_mcp/registry_base.rb:21
    def register(klass); end

    # Return the number of registered items, ignoring abstract ones.
    #
    # @return [Integer] The number of registered items.
    #
    # pkg:gem/actionmcp#lib/action_mcp/registry_base.rb:72
    def size; end

    # Unregister an item
    #
    # @param klass [Class] The class to unregister
    # @return [void]
    #
    # pkg:gem/actionmcp#lib/action_mcp/registry_base.rb:53
    def unregister(klass); end

    private

    # Helper to determine if an item is abstract.
    #
    # @param klass [Class] The class to check.
    # @return [Boolean] True if the class is abstract, false otherwise.
    #
    # pkg:gem/actionmcp#lib/action_mcp/registry_base.rb:96
    def abstract_item?(klass); end

    # pkg:gem/actionmcp#lib/action_mcp/registry_base.rb:100
