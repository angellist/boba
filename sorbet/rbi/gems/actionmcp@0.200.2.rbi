# pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:4
module ActionMCP::Dev; end

# A single command that boots the ActionMCP dev loop: the standalone MCP
# server plus, when a compiled-views tier is present, the vite view builder
# in watch mode, plus an optional public tunnel.
#
# Note on the reload model: MCP Apps views are delivered to hosts as
# inlined resource text inside a sandboxed iframe, so there is no websocket
# channel for classic in-browser HMR. The dev loop is watch-and-rebuild:
# editing a view triggers a vite rebuild of its bundle + manifest, and the
# next tool invocation in the MCP client renders the fresh view.
#
# Usage from the generated binstub:
#   ActionMCP::Dev::Runner.new(root: Dir.pwd, argv: ARGV).run
#
# pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:17
class ActionMCP::Dev::Runner
  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:27
  def initialize(root:, argv: T.unsafe(nil), env: T.unsafe(nil), out: T.unsafe(nil)); end

  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:25
  def options; end

  # The set of child processes this invocation would start. Pure — no
  # spawning — so the wiring is unit-testable.
  #
  # @return [Array<Spec>]
  #
  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:39
  def plan; end

  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:25
  def root; end

  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:52
  def run; end

  # Whether the vite view-builder should run: opt-in tier is present and the
  # user did not disable it.
  #
  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:48
  def run_views?; end

  private

  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:128
  def falcon_available?; end

  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:141
  def install_signal_traps; end

  # Prefer the package runner matching the lockfile in the project so the
  # locally-installed @action-mcp/vite-plugin bin resolves.
  #
  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:118
  def node_runner; end

  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:68
  def parse(argv); end

  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:176
  def print_banner(specs); end

  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:93
  def server_spec; end

  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:161
  def shutdown(sig); end

  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:135
  def spawn(spec); end

  # Wait for any child to exit; when one dies, tear the rest down so the dev
  # loop never limps along half-up.
  #
  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:149
  def supervise; end

  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:111
  def tunnel_spec; end

  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:187
  def usage; end

  # pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:106
  def views_spec; end
end

# pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:20
ActionMCP::Dev::Runner::BUILD_BIN = T.let(T.unsafe(nil), String)

# pkg:gem/actionmcp#lib/action_mcp/dev/runner.rb:18
ActionMCP::Dev::Runner::DEFAULT_PORT = T.let(T.unsafe(nil), Integer)

