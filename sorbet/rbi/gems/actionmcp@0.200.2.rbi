    #
    # @return [Hash] A hash of registered items.
    #
    # pkg:gem/actionmcp#lib/action_mcp/registry_base.rb:13
    def items; end

    # Chainable scope: returns only non-abstract items.
    #
    # @return [RegistryScope] A RegistryScope instance.
    #
    # pkg:gem/actionmcp#lib/action_mcp/registry_base.rb:79
    def non_abstract; end

    # Re-register an item under its current capability_name
    # Removes old entry if name changed
